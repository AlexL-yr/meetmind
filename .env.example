# ── Anthropic (Claude) — 可选，当前审计层已改为全 Gemini，无需填写 ──────────
# ANTHROPIC_API_KEY=                  # Get from https://console.anthropic.com
# MODEL_NAME_CLAUDE=claude-sonnet-4-20250514

# ── Google AI Studio (Gemini, free tier) ────────────────────────────────────
GOOGLE_API_KEY=                       # Get from https://aistudio.google.com
MODEL_NAME_GEMINI=gemini-2.0-flash

# ── Shared LLM settings ─────────────────────────────────────────────────────
LLM_TEMPERATURE=0.7

# ── ChromaDB (local, no API key needed) ─────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── FastAPI service ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=                              # Optional: require bearer token auth
REQUIRE_AUTH=false
